{
  "name": "taoguan-lawlink-desktop",
  "productName": "韬冠律所",
  "version": "2.1.0",
  "description": "韬冠律所全流程综合管理系统 — Windows / macOS 跨平台桌面客户端",
  "author": "TaoGuan Law Firm",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "pack:dir": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "cn.taoguanlaw.lawlink.desktop",
    "productName": "TaoGuan-LawLink",
    "copyright": "Copyright © 2026 TaoGuan Law Firm (Based on LawLink MIT)",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "launcher.html",
      "assets/**/*"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "韬冠律所管理系统",
      "artifactName": "TaoGuan-LawLink-Setup-${version}-win-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "TaoGuan-LawLink-Portable-${version}-win-${arch}.${ext}"
    },
    "mac": {
      "icon": "assets/icon.png",
      "category": "public.app-category.business",
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] }
      ],
      "artifactName": "TaoGuan-LawLink-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": ["AppImage"],
      "category": "Office",
      "artifactName": "TaoGuan-LawLink-${version}-linux-${arch}.${ext}"
    }
  }
}
